---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeartAccent from '../components/HeartAccent.astro';
import heroImage from '../assets/images/hero.jpg';
import {
	PARTNER_ONE,
	PARTNER_TWO,
	SITE_DESCRIPTION,
	WEDDING_DATE,
	WEDDING_DATE_LABEL,
	WEDDING_VENUE,
} from '../consts';
---

<Layout title={`${PARTNER_ONE} & ${PARTNER_TWO}`} description={SITE_DESCRIPTION}>
	<Image
		src={heroImage}
		alt={`${PARTNER_ONE} & ${PARTNER_TWO}`}
		widths={[400, 800, 1200, 2000]}
		sizes="(min-width: 720px) 720px, 100vw"
		class="hero-image"
	/>
	<section class="hero">
		<span class="eyebrow"><HeartAccent /> Wij trouwen <HeartAccent /></span>
		<h1>
			{PARTNER_ONE} & {PARTNER_TWO}
		</h1>
		<p class="date-venue">{WEDDING_DATE_LABEL} — {WEDDING_VENUE}</p>
		<p>
			Na jaren samen zetten we de volgende stap. We nodigen je van harte uit om deze dag samen met
			ons te vieren.
		</p>
		<div class="cta">
			<a class="btn btn-solid" href="/rsvp">RSVP</a>
			<a class="btn" href="/programma">Bekijk het programma</a>
		</div>
	</section>

	<section class="countdown" data-wedding-date={WEDDING_DATE.toISOString()}>
		<div class="countdown-item" data-item="months" hidden>
			<span class="countdown-value" data-unit="months">–</span>
			<span class="countdown-label">maanden</span>
		</div>
		<div class="countdown-item">
			<span class="countdown-value" data-unit="days">–</span>
			<span class="countdown-label">dagen</span>
		</div>
		<div class="countdown-item">
			<span class="countdown-value" data-unit="hours">–</span>
			<span class="countdown-label">uren</span>
		</div>
		<div class="countdown-item">
			<span class="countdown-value" data-unit="minutes">–</span>
			<span class="countdown-label">minuten</span>
		</div>
		<div class="countdown-item">
			<span class="countdown-value" data-unit="seconds">–</span>
			<span class="countdown-label">seconden</span>
		</div>
	</section>
</Layout>

<script>
	function addMonths(date: Date, months: number) {
		const result = new Date(date);
		const day = result.getDate();
		result.setDate(1);
		result.setMonth(result.getMonth() + months);
		const lastDay = new Date(result.getFullYear(), result.getMonth() + 1, 0).getDate();
		result.setDate(Math.min(day, lastDay));
		return result;
	}

	function updateCountdown() {
		const section = document.querySelector('.countdown');
		if (!(section instanceof HTMLElement)) return;
		const target = new Date(section.dataset.weddingDate ?? '');
		const now = new Date();
		const totalDiff = Math.max(0, target.getTime() - now.getTime());

		// Show calendar months only while more than 31 days remain.
		let months = 0;
		let anchor = now;
		if (totalDiff > 31 * 86400 * 1000) {
			months =
				(target.getFullYear() - now.getFullYear()) * 12 + (target.getMonth() - now.getMonth());
			anchor = addMonths(now, months);
			if (anchor > target) {
				months--;
				anchor = addMonths(now, months);
			}
		}

		const seconds = Math.floor(Math.max(0, target.getTime() - anchor.getTime()) / 1000);
		const values = {
			months,
			days: Math.floor(seconds / 86400),
			hours: Math.floor((seconds % 86400) / 3600),
			minutes: Math.floor((seconds % 3600) / 60),
			seconds: seconds % 60,
		};

		const monthsItem = section.querySelector('[data-item="months"]');
		if (monthsItem instanceof HTMLElement) monthsItem.hidden = months === 0;

		for (const [unit, value] of Object.entries(values)) {
			const el = section.querySelector(`[data-unit="${unit}"]`);
			if (el) el.textContent = String(value).padStart(2, '0');
		}
	}

	updateCountdown();
	setInterval(updateCountdown, 1000);
</script>

<style>
	.hero-image {
		display: block;
		width: 100%;
		max-height: 60vh;
		object-fit: cover;
		border-radius: 0 0 12px 12px;
	}
	.hero {
		text-align: center;
		padding: 2em 0 3em;
	}
	.hero h1 {
		font-size: 3.5em;
		margin-bottom: 0.2em;
	}
	.title-heart {
		font-size: 0.5em;
	}
	.date-venue {
		font-size: 1.1em;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--accent-dark);
		margin-bottom: 1.5em;
	}
	.cta {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5em;
	}
	.countdown {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		flex-wrap: wrap;
		padding: 2em 0 3em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.countdown-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 4.5em;
	}
	.countdown-item[hidden] {
		display: none;
	}
	.countdown-value {
		font-size: 2.5em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.countdown-label {
		margin-top: 0.4em;
		font-size: 0.85em;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	@media (max-width: 480px) {
		.hero h1 {
			font-size: 2.5em;
		}
	}
</style>
