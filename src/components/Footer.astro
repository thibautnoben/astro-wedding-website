---
import { Image } from 'astro:assets';
import { PARTNER_ONE, PARTNER_TWO, CONTACT_EMAIL } from '../consts';
import bike from '../assets/images/bike.png';
const today = new Date();
---

<footer>
	<!-- The footer's top edge is a slope; the bike rides up it from right to left. -->
	<div class="footer-hill" aria-hidden="true">
		<div class="footer-rider">
			<Image src={bike} alt="" class="footer-bike" width={60} densities={[1, 2]} loading="lazy" />
		</div>
	</div>
	&copy; {today.getFullYear()} {PARTNER_ONE} & {PARTNER_TWO}
	<div class="contact">
		Vragen? Mail naar <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</div>
</footer>
<style>
	footer {
		--angle: 3deg;
		/* Height difference between the left and right end of the slope. */
		--rise: calc(100vw * tan(var(--angle)));
		--bike-w: 60px;

		position: relative;
		isolation: isolate;
		/* Never let the riding bike widen the page; vertical overflow stays visible. */
		overflow-x: clip;
		margin-top: 3em;
		padding: calc(var(--rise) + 2em) 1em 6em 1em;
		color: rgb(var(--gray));
		text-align: center;
	}

	/* Background with a sloped top edge: high on the left, low on the right. */
	footer::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		clip-path: polygon(0 0, 100% var(--rise), 100% 100%, 0 100%);
	}

	/* A zero-height line lying exactly on the sloped edge. */
	.footer-hill {
		position: absolute;
		top: 0;
		left: 0;
		width: calc(100% / cos(var(--angle)));
		height: 0;
		transform-origin: 0 0;
		transform: rotate(var(--angle));
		pointer-events: none;
		/* Lets the rider use cqw = length of the slope. */
		container-type: inline-size;
	}

	/* Bike-sized box that moves along the slope. */
	.footer-rider {
		position: absolute;
		left: 0;
		bottom: 0;
		width: var(--bike-w);
		/* Parked at the bottom (right) of the hill unless animating. */
		translate: calc(100cqw - var(--bike-w) - 1em) 0;
	}

	.footer-bike {
		position: absolute;
		left: 0;
		bottom: -3px;
		width: var(--bike-w);
		height: auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		.footer-rider {
			animation: footer-ride 34.5s linear infinite;
		}
		/* Pedalling effort: a small bob while climbing. */
		.footer-bike {
			animation: footer-pedal 0.45s ease-in-out infinite alternate;
		}
	}

	/*
	 * One 34.5s loop:
	 *   0    – 24s     climb, right → left            (0%      – 69.57%)
	 *   24   – 24.75s  rest at the summit             (69.57%  – 71.74%)
	 *   24.75 – 25.25s turn around (mirror)           (71.74%  – 73.19%)
	 *   25.25 – 33.25s ride down, 3× faster (8s)      (73.19%  – 96.38%)
	 *   33.25 – 34s    rest at the bottom             (96.38%  – 98.55%)
	 *   34   – 34.5s   turn around again              (98.55%  – 100%)
	 */
	@keyframes footer-ride {
		0% {
			translate: calc(100cqw - var(--bike-w)) 0;
			scale: 1 1;
			animation-timing-function: ease-in-out;
		}
		69.57%,
		71.74% {
			translate: 0 0;
			scale: 1 1;
			animation-timing-function: ease-in-out;
		}
		73.19% {
			translate: 0 0;
			scale: -1 1;
			animation-timing-function: ease-in-out;
		}
		96.38%,
		98.55% {
			translate: calc(100cqw - var(--bike-w)) 0;
			scale: -1 1;
			animation-timing-function: ease-in-out;
		}
		100% {
			translate: calc(100cqw - var(--bike-w)) 0;
			scale: 1 1;
		}
	}

	@keyframes footer-pedal {
		from {
			translate: 0 0;
			rotate: 0deg;
		}
		to {
			translate: 0 -1.5px;
			rotate: -1deg;
		}
	}

	.contact {
		margin-top: 0.5em;
	}
	.contact a {
		color: rgb(var(--gray));
		text-decoration: underline;
	}
	.contact a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
